# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (Allowed frontend origin or comma-separated list of origins)
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# PostgreSQL Database Configuration
# Option 1: Full Connection String URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/internship_management

# Option 2: Individual Connection Parameters (used if DATABASE_URL is omitted or as overrides)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=internship_management
DB_USER=postgres
DB_PASSWORD=password
